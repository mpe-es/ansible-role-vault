# {{ ansible_managed }}
# Vault unseal shares (Shamir) — consumed by vault-unseal.service on boot.
# The root token is NEVER stored on the node (issue #34); it is captured to the
# controller only. Mode 0600, owned by root:root.
# SECURITY: This file contains sensitive unseal key material.
{% for key in __vault_init_data.unseal_keys_b64 %}
VAULT_UNSEAL_KEY_{{ loop.index }}={{ key }}
{% endfor %}
