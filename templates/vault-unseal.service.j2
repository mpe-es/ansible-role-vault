# {{ ansible_managed }}
[Unit]
Description=Auto-Unseal HashiCorp Vault Service
After=network.target
After={{ vault_service_name }}.service
# Requires couples this oneshot to the Vault service so an operator
# `systemctl restart {{ vault_service_name }}` re-runs the unseal as well.
Requires={{ vault_service_name }}.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/bin/vault-unseal.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=VAULT_CACERT={{ vault_tls_ca_file }}
Environment=VAULT_ADDR=https://127.0.0.1:{{ vault_listener_port }}
# Runs as root by design: the unseal keys in /etc/vault-unseal/tokens.env
# are root-only (0600 in a root:root 0700 directory) so the vault service
# account can never read or replace its own unseal keys. Do NOT add a
# service account directive here without changing that model.

# Security hardening (kept minimal: heavier sandboxing directives are
# deferred until verified against the vault CLI on a real host)
PrivateTmp=yes
NoNewPrivileges=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vault-unseal

# Bounds the script's API wait phase (60s default) plus key application;
# a hung listener mid-application can still hit this ceiling, which fails
# the unit — the honest outcome.
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
