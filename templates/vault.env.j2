# {{ ansible_managed }}
# Vault environment variables
# Sourced by vault.service systemd unit
VAULT_ADDR=https://127.0.0.1:{{ vault_listener_port }}
VAULT_CACERT={{ vault_tls_ca_file }}
DBUS_SESSION_BUS_ADDRESS=/dev/null
{% if vault_hsm_enabled | bool and (vault_hsm_pin | default('') | length > 0) %}
{# HSM PKCS#11 seal PIN (issue #41): double-quoted so systemd EnvironmentFile #}
{# returns the value verbatim (it strips a surrounding quote pair + unquoted   #}
{# leading/trailing whitespace). Charset validated in configure.yml.          #}
VAULT_HSM_PIN="{{ vault_hsm_pin }}"
{% endif %}
