{{ ansible_managed | comment }}
###############################################################################
# Vault Server Configuration
# Generated by ansible-role-vault
# Classification: UNCLASSIFIED
###############################################################################

###############################################################################
# Server Parameters
###############################################################################
ui            = {{ vault_ui_enabled | lower }}
disable_mlock = {{ vault_disable_mlock | lower }}
log_level     = "{{ vault_log_level }}"

{% if vault_edition is match('vault-enterprise') %}
# Enterprise-only parameter
disable_performance_standby = {{ vault_disable_performance_standby | lower }}
{% endif %}

###############################################################################
# Integrated Storage (Raft)
# HashiCorp recommended storage backend for all deployments.
# NIST 800-53: SC-28 (Protection of Information at Rest)
###############################################################################
storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ vault_raft_node_id }}"
{% if vault_cluster_leader_addr | default('') | length > 0 %}

  retry_join {
    leader_api_addr     = "https://{{ vault_cluster_leader_addr }}:{{ vault_listener_port }}"
    leader_ca_cert_file = "{{ vault_tls_ca_file }}"
  }
{% endif %}
}

###############################################################################
# Cluster Addresses
###############################################################################
api_addr     = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"

###############################################################################
# TCP Listener
# NIST 800-53: SC-8 (Transmission Confidentiality and Integrity)
# NIST 800-53: SC-23 (Session Authenticity)
###############################################################################
listener "tcp" {
  address         = "{{ vault_listener_address }}:{{ vault_listener_port }}"
  tls_cert_file   = "{{ vault_tls_cert_file }}"
  tls_key_file    = "{{ vault_tls_key_file }}"
  tls_client_ca_file = "{{ vault_tls_ca_file }}"

  # TLS version enforcement (STIG: TLS 1.2 minimum)
  tls_min_version = "{{ vault_tls_min_version }}"
  tls_max_version = "{{ vault_tls_max_version }}"
{% if vault_tls_cipher_suites | default([]) | length > 0 %}

  # TLS 1.2 cipher suites (TLS 1.3 uses fixed suites)
  # CNSA 1.0: AES-256-GCM with SHA-384, ECDHE with P-384
  tls_cipher_suites = "{{ vault_tls_cipher_suites | join(',') }}"
{% endif %}

  # Client certificate handling
  tls_require_and_verify_client_cert = {{ vault_tls_require_client_cert | lower }}
  tls_disable_client_certs           = {{ vault_tls_disable_client_certs | lower }}
}

{% if vault_hsm_enabled %}
###############################################################################
# PKCS#11 HSM Seal (Enterprise Only)
# NIST 800-53: SC-13 (Cryptographic Protection)
# FIPS 140-3: Hardware security module for key protection
###############################################################################
seal "pkcs11" {
  lib            = "{{ vault_hsm_lib_path }}"
{% if vault_hsm_slot | default('') | length > 0 %}
  slot           = "{{ vault_hsm_slot }}"
{% endif %}
{% if vault_hsm_token_label | default('') | length > 0 %}
  token_label    = "{{ vault_hsm_token_label }}"
{% endif %}
  pin            = "{{ vault_hsm_pin }}"
  key_label      = "{{ vault_hsm_key_label }}"
  hmac_key_label = "{{ vault_hsm_hmac_key_label }}"
{% if vault_hsm_mechanism | default('') | length > 0 %}
  mechanism      = "{{ vault_hsm_mechanism }}"
{% endif %}
  hmac_mechanism = "{{ vault_hsm_hmac_mechanism }}"
  generate_key   = "{{ vault_hsm_generate_key | lower }}"
  max_parallel   = {{ vault_hsm_max_parallel }}
}
{% endif %}
